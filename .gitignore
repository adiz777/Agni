# ==========================================
# Agni (अग्नि) .gitignore
# ==========================================

# Multi-Agent Internal Workspace & Metadata
.agents/
.gemini/

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Pytest & Linters
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Databases & Runtime State
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.pid
*.log
agni_local.db

# Node.js & Frontend Build
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.eslintcache

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# Ensure documentation assets are always tracked
!docs/assets/*.png
!docs/assets/*.svg
