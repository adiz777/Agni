# ==============================================================================
# Agni (अग्नि) Threat Detection Engine - Environment Configuration
# ==============================================================================
# Copy this file to .env to override defaults. All variables use the AGNI_ prefix.

# Network Binding & Security
# Strictly restricted to local loopback (127.0.0.1) for local-first zero-trust privacy.
AGNI_HOST=127.0.0.1
AGNI_PORT=8000
AGNI_ALLOW_EXTERNAL_BIND=false

# API Versioning & Paths
AGNI_API_V1_STR=/api/v1
# AGNI_DATABASE_URL=sqlite:///./data/agni.db

# Monitoring Intervals (seconds)
AGNI_TELEMETRY_INTERVAL_SECONDS=5
AGNI_FIM_POLL_INTERVAL_SECONDS=60
AGNI_NETWORK_POLL_INTERVAL_SECONDS=15
AGNI_CORRELATION_WINDOW_SECONDS=300
AGNI_EVENT_RETENTION_DAYS=30

# Resource Limits & Safety Guards
AGNI_MAX_REQUEST_SIZE_BYTES=10485760
AGNI_MAX_FIM_FILE_SIZE_BYTES=104857600
AGNI_MAX_SOCKETS_PER_CYCLE=2000

# Demo & Synthetic Telemetry Mode (true/false)
AGNI_DEMO_MODE_DEFAULT=false

# AI Advisory Engine (Optional - Local Ollama or Gemini API)
# AGNI_AI_PROVIDER=none
# AGNI_AI_OLLAMA_URL=http://127.0.0.1:11434
# AGNI_AI_MODEL=llama3.2
# GEMINI_API_KEY=your_gemini_api_key_here
